{
  "name": "dsh-agentflow",
  "version": "0.7.0",
  "description": "Declarative multi-agent workflow engine for DeepSeek Harness: YAML templates, hard agent budgets, verified citation anchors, run artifacts and a sidebar run panel.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workflow",
    "agent",
    "multi-agent",
    "orchestration",
    "eval"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/**/*.js",
    "templates/*.yaml",
    "eval/*.json",
    "tools/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "docs/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "node": ">=22.12.0",
    "dsh": ">=0.2.1-rc.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/",
    "panel": "node tools/panel.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.3.2"
  }
}

